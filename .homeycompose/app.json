{
  "id": "com.seyedjafari.bmwconnected",
  "version": "1.1.0",
  "compatibility": ">=12.9.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "CarData for BMW & MINI"
  },
  "description": {
    "en": "Your BMW or MINI's battery, charging, range, doors and locks live in Homey, with a battery widget for your dashboard.",
    "nl": "De batterij, het laden, de actieradius, deuren en sloten van je BMW of MINI live in Homey, met een batterijwidget voor je dashboard."
  },
  "brandColor": "#009ADA",
  "category": [
    "tools"
  ],
  "tags": {
    "en": [
      "bmw",
      "mini",
      "car",
      "ev",
      "electric car",
      "charging",
      "battery",
      "cardata",
      "connecteddrive"
    ]
  },
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Seyed Jafari",
    "email": "hello@seyedjafari.com"
  },
  "contributors": {
    "developers": [
      {
        "name": "Likhan Siddiquee",
        "email": "likhan.siddiquee@gmail.com"
      },
      {
        "name": "Sander Schutten",
        "email": "sander@dotnetstudio.nl"
      },
      {
        "name": "Glenn Heylen"
      }
    ],
    "translators": [
      {
        "name": "Sander Schutten",
        "email": "sander@dotnetstudio.nl"
      }
    ]
  },
  "api": {
    "saveSettings": {
      "method": "POST",
      "path": "/saveSettings"
    },
    "getLogs": {
      "method": "GET",
      "path": "/getLogs"
    },
    "resolveAddress": {
      "method": "GET",
      "path": "/resolveAddress"
    },
    "getCurrentLocation": {
      "method": "GET",
      "path": "/getCurrentLocation"
    },
    "clearTokenStore": {
      "method": "POST",
      "path": "/clearTokenStore"
    },
    "getRegisteredDevices": {
      "method": "GET",
      "path": "/getRegisteredDevices"
    },
    "getClientTokens": {
      "method": "GET",
      "path": "/getClientTokens"
    },
    "getEventLog": {
      "method": "GET",
      "path": "/getEventLog"
    }
  },
  "source": "https://github.com/helloseyedjafari/bmw-cardata-homey",
  "homepage": "https://github.com/helloseyedjafari/bmw-cardata-homey",
  "support": "https://github.com/helloseyedjafari/bmw-cardata-homey/issues"
}
